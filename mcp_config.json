{
  "mcpServers": {
    "strava": {
      "command": "npx",
      "args": ["-y", "@r-huijts/strava-mcp-server"],
      "env": {
        "STRAVA_CLIENT_ID": "199188"
      },
      "allowedTools": [
        "get-athlete-profile",
        "get-recent-activities",
        "get-athlete-stats"
      ],
      "ingest": [
        {
          "tool": "get-athlete-profile",
          "args": {},
          "source": "profile",
          "title": "Strava Athlete Profile"
        },
        {
          "tool": "get-recent-activities",
          "args": { "limit": 10 },
          "source": "activities",
          "title": "Recent Activities",
          "itemTemplate": "I completed a Strava {type} named \"{name}\" covering {distance:km} in {moving_time:min} with an average heart rate of {average_heartrate} bpm on {start_date:date}."
        }
      ]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {},
      "allowedTools": [
        "search_repositories",
        "get_file_contents",
        "list_commits"
      ],
      "ingest": [
        {
          "tool": "search_repositories",
          "args": {
            "query": "user:rohitprasad-code"
          },
          "source": "repos",
          "title": "GitHub Repositories",
          "itemTemplate": "I have a GitHub repository named \"{name}\" described as \"{description}\", primarily written in {language}. It has {stargazers_count} stars (last updated on {updated_at:date}). URL: {html_url}"
        }
      ]
    },
    "web-search": {
      "command": "npx",
      "args": ["-y", "@rp-x/web-mcp-server"],
      "env": {},
      "allowedTools": ["search_web", "fetch_page_markdown"],
      "ingest": [
        {
          "tool": "search_web",
          "args": {
            "query": "technology"
          },
          "source": "search",
          "title": "Web Search"
        }
      ]
    },
    "presence-monitor": {
      "command": "node",
      "args": [
        "/Users/rohitprasad/Backup/mcp-s/presence-mcp-server/dist/server.js"
      ],
      "env": {},
      "allowedTools": [
        "get_presence_status",
        "get_system_idle_time",
        "get_active_call_status"
      ],
      "ingest": [
        {
          "tool": "get_presence_status",
          "args": {},
          "source": "presence",
          "title": "Presence Status"
        }
      ]
    },
    "smart-home": {
      "command": "uv",
      "args": [
        "--directory",
        "/Users/rohitprasad/Backup/mcp-s/smart-home-mcp-server",
        "run",
        "smart-home-mcp"
      ],
      "env": {},
      "allowedTools": [
        "list_devices",
        "get_device_status",
        "scan_local_network"
      ],
      "ingest": [
        {
          "tool": "list_devices",
          "args": {},
          "source": "devices",
          "title": "Smart Home Devices"
        }
      ]
    }
  }
}
